<mxfile host="app.diagrams.net" modified="2026-03-20T14:00:00.000Z" agent="Cascade" version="24.0.0" type="device">
  <diagram id="ml-pipeline" name="ML Anomaly Detection Pipeline">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title" value="ML Anomaly Detection Pipeline — Isolation Forest" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=18;fontStyle=1;fontColor=#1a1a2e;" vertex="1" parent="1">
          <mxGeometry x="300" y="20" width="500" height="30" as="geometry"/>
        </mxCell>

        <!-- Input: Feature Vector -->
        <mxCell id="input" value="Feature Vector (18-dim)&#xa;from Kafka: feature-vectors" style="shape=parallelogram;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="220" height="50" as="geometry"/>
        </mxCell>

        <!-- Training Buffer -->
        <mxCell id="buffer-bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f9a825;opacity=50;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="220" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="buffer-title" value="Training Data Buffer" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=12;fontStyle=1;fontColor=#f9a825;" vertex="1" parent="1">
          <mxGeometry x="40" y="205" width="220" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="buffer-ring" value="Circular Buffer&#xa;(max 50,000 vectors)&#xa;&#xa;Each vector added on arrival.&#xa;Old vectors evicted when&#xa;buffer is full (FIFO)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;align=left;" vertex="1" parent="1">
          <mxGeometry x="55" y="235" width="190" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="buffer-count" value="Min samples for training: 100&#xa;Retrain interval: 6 hours" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=9;fontStyle=2;fontColor=#666;" vertex="1" parent="1">
          <mxGeometry x="55" y="330" width="190" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="e-in-buf" value="accumulate" style="strokeColor=#f9a825;strokeWidth=2;fontSize=9;fontStyle=2;" edge="1" source="input" target="buffer-ring" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Online Scoring Path -->
        <mxCell id="scoring-bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#c62828;opacity=30;" vertex="1" parent="1">
          <mxGeometry x="320" y="70" width="450" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="scoring-title" value="Online Scoring Path (per event, &lt;1ms)" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=12;fontStyle=1;fontColor=#c62828;" vertex="1" parent="1">
          <mxGeometry x="320" y="75" width="450" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="preprocess" value="Preprocessing&#xa;• NaN → 0&#xa;• Inf → 0&#xa;• Reshape (1, 18)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6d0de;strokeColor=#996185;fontSize=9;align=left;" vertex="1" parent="1">
          <mxGeometry x="330" y="105" width="120" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="iforest" value="Isolation Forest&#xa;decision_function()&#xa;&#xa;200 trees&#xa;max_samples=1024" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6d0de;strokeColor=#996185;fontSize=9;align=left;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="480" y="105" width="130" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="normalize" value="Score Normalization&#xa;raw → [0, 1]&#xa;score = max(0, min(1,&#xa;  -raw_score + 0.5))" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6d0de;strokeColor=#996185;fontSize=9;align=left;" vertex="1" parent="1">
          <mxGeometry x="640" y="105" width="120" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="e-in-pre" value="score" style="strokeColor=#c62828;strokeWidth=2;fontSize=9;fontStyle=2;" edge="1" source="input" target="preprocess" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-pre-if" style="strokeColor=#996185;strokeWidth=2;" edge="1" source="preprocess" target="iforest" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-if-norm" style="strokeColor=#996185;strokeWidth=2;" edge="1" source="iforest" target="normalize" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Severity Classification -->
        <mxCell id="severity-bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#c62828;opacity=30;" vertex="1" parent="1">
          <mxGeometry x="320" y="230" width="450" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="severity-title" value="Severity Classification &amp; Feature Attribution" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=12;fontStyle=1;fontColor=#c62828;" vertex="1" parent="1">
          <mxGeometry x="320" y="235" width="450" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="classify" value="Severity Thresholds&#xa;&#xa;0.0–0.5: NONE&#xa;0.5–0.6: LOW&#xa;0.6–0.75: MEDIUM&#xa;0.75–0.9: HIGH&#xa;0.9–1.0: CRITICAL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcdd2;strokeColor=#c62828;fontSize=8;align=left;" vertex="1" parent="1">
          <mxGeometry x="330" y="260" width="120" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="attribution" value="Feature Attribution&#xa;&#xa;Top-5 features by magnitude:&#xa;1. privileged_event_ratio&#xa;2. process_creation_rate&#xa;3. syscall_entropy&#xa;4. unique_dest_ips&#xa;5. uid_zero_ratio" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcdd2;strokeColor=#c62828;fontSize=8;align=left;" vertex="1" parent="1">
          <mxGeometry x="480" y="260" width="140" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="description" value="Human-Readable Description&#xa;&#xa;&quot;Anomalous behavior detected&#xa;(score: 0.870). Top features:&#xa;privileged_event_ratio,&#xa;process_creation_rate&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcdd2;strokeColor=#c62828;fontSize=8;align=left;" vertex="1" parent="1">
          <mxGeometry x="640" y="260" width="120" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="e-norm-class" style="strokeColor=#c62828;strokeWidth=2;" edge="1" source="normalize" target="classify" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-class-attr" style="strokeColor=#c62828;strokeWidth=1;" edge="1" source="classify" target="attribution" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-attr-desc" style="strokeColor=#c62828;strokeWidth=1;" edge="1" source="attribution" target="description" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Output -->
        <mxCell id="output" value="Anomaly Result&#xa;→ Kafka: anomaly-results" style="shape=parallelogram;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="830" y="270" width="220" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="e-desc-out" value="publish" style="strokeColor=#b85450;strokeWidth=2;fontSize=9;fontStyle=2;" edge="1" source="description" target="output" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Batch Retraining Path -->
        <mxCell id="retrain-bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;opacity=30;" vertex="1" parent="1">
          <mxGeometry x="40" y="440" width="730" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="retrain-title" value="Batch Retraining Path (every 6 hours)" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=12;fontStyle=1;fontColor=#2e7d32;" vertex="1" parent="1">
          <mxGeometry x="40" y="445" width="730" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="scheduler" value="Retrain Scheduler&#xa;(threading.Timer)&#xa;interval: 6h" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#2e7d32;fontSize=9;align=left;" vertex="1" parent="1">
          <mxGeometry x="55" y="480" width="120" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="extract" value="Extract Training Data&#xa;from circular buffer&#xa;(thread-safe lock)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#2e7d32;fontSize=9;align=left;" vertex="1" parent="1">
          <mxGeometry x="210" y="480" width="130" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="train" value="IsolationForest.fit()&#xa;contamination=0.05&#xa;n_estimators=200&#xa;n_jobs=-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#2e7d32;fontSize=9;align=left;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="375" y="480" width="130" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="persist" value="Model Persistence&#xa;joblib.dump()&#xa;model_{version}.joblib&#xa;version = timestamp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#2e7d32;fontSize=9;align=left;" vertex="1" parent="1">
          <mxGeometry x="540" y="480" width="130" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="hotswap" value="Hot-swap Model&#xa;self.model = new_model&#xa;(atomic reference swap)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#2e7d32;fontSize=9;align=left;" vertex="1" parent="1">
          <mxGeometry x="700" y="480" width="130" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="e-sch-ext" style="strokeColor=#2e7d32;strokeWidth=2;" edge="1" source="scheduler" target="extract" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-ext-train" style="strokeColor=#2e7d32;strokeWidth=2;" edge="1" source="extract" target="train" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-train-persist" style="strokeColor=#2e7d32;strokeWidth=2;" edge="1" source="train" target="persist" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-persist-swap" style="strokeColor=#2e7d32;strokeWidth=2;" edge="1" source="persist" target="hotswap" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Connect buffer to retrain -->
        <mxCell id="e-buf-ext" value="read" style="strokeColor=#f9a825;strokeWidth=1;dashed=1;fontSize=9;fontStyle=2;" edge="1" source="buffer-ring" target="extract" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Connect hotswap to iforest -->
        <mxCell id="e-swap-if" value="update model" style="strokeColor=#2e7d32;strokeWidth=1;dashed=1;fontSize=9;fontStyle=2;" edge="1" source="hotswap" target="iforest" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Metrics -->
        <mxCell id="metrics" value="Prometheus Metrics&#xa;• ml_events_scored_total&#xa;• ml_anomalies_detected_total{severity}&#xa;• ml_scoring_latency_seconds&#xa;• ml_model_version_timestamp&#xa;• ml_training_buffer_size" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f3ff;strokeColor=#4a86c8;fontSize=8;align=left;" vertex="1" parent="1">
          <mxGeometry x="830" y="100" width="200" height="90" as="geometry"/>
        </mxCell>

        <!-- REST Endpoints -->
        <mxCell id="rest-endpoints" value="REST API (Flask :8084)&#xa;• GET /health&#xa;• GET /metrics&#xa;• GET /model/info&#xa;• POST /model/retrain&#xa;• POST /score" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f3ff;strokeColor=#4a86c8;fontSize=8;align=left;" vertex="1" parent="1">
          <mxGeometry x="830" y="370" width="200" height="80" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
